# Public host and Discourse
CONNECT_HOST=connect.xai.run
DISCOURSE_URL=https://xai.run
DISCOURSE_SHARED_SECRET=replace-with-a-random-32-byte-or-longer-secret

# PostgreSQL (Portal and Hydra share the same PostgreSQL instance/database;
# use a separate database in larger deployments if desired.)
POSTGRES_DB=connect
POSTGRES_USER=connect
POSTGRES_PASSWORD=replace-with-a-database-password
HYDRA_DB_USER=connect
HYDRA_DB_PASSWORD=replace-with-the-database-password

# 32 raw bytes encoded as standard or raw base64, hex, or exactly 32 ASCII bytes.
# Store this outside source control and back it up separately from PostgreSQL.
CONNECT_ENCRYPTION_KEY=replace-with-32-byte-base64

# Hydra signing and cookie secrets. Use independent high-entropy values.
HYDRA_SYSTEM_SECRET=replace-with-a-hydra-system-secret
HYDRA_COOKIE_SECRET=replace-with-a-hydra-cookie-secret
HYDRA_PAIRWISE_SALT=replace-with-a-hydra-pairwise-salt

PORTAL_PORT=8080
HYDRA_PUBLIC_PORT=4444
